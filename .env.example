# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.

# Vốn (VND) dùng tính position size. Thiếu → mặc định 100000000.
CAPITAL_VND=

# Telegram Bot API (Phase 4). Thiếu → bỏ qua gửi alert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API cho news sentiment (Phase 3). Thiếu → sentiment = 0.
ANTHROPIC_API_KEY=

# Tắt telemetry tuỳ chọn của vnstock/vnai (code cũng tự đặt mặc định = 0).
VNSTOCK_TELEMETRY=0
